
import { useEffect, useMemo, useState } from "react";
import { Link, useNavigate, useParams } from "react-router-dom";
import {
  ArrowLeft, CalendarDays, MapPin, Clock, Ticket,
  Armchair, CheckCircle2, CreditCard, LoaderCircle,
  Film, AlertCircle
} from "lucide-react";
import "./BookingPage.css";

const API = "http://localhost:5000/api";

const formatMoney = (amount) =>
  new Intl.NumberFormat("vi-VN").format(amount || 0) + "đ";

const getId = (value) => {
  if (value && typeof value === "object") {
    return String(value._id || value.id || "");
  }
  return String(value || "");
};

const formatDate = (date) => {
  const year = date.getFullYear();
  const month = String(date.getMonth() + 1).padStart(2, "0");
  const day = String(date.getDate()).padStart(2, "0");
  return `${year}-${month}-${day}`;
};

const formatTime = (date) =>
  new Date(date).toLocaleTimeString("vi-VN", {
    hour: "2-digit",
    minute: "2-digit"
  });

function BookingPage() {
  const params = useParams();
  const navigate = useNavigate();

  // Lấy movieId từ React Router hoặc trực tiếp từ URL.
  // Cách này xử lý được trường hợp App.jsx dùng startsWith().
  const movieId = String(
    params.movieId ||
    window.location.pathname.split("/").filter(Boolean).pop() ||
    ""
  ).trim();

  const [movie, setMovie] = useState(null);
  const [cinemas, setCinemas] = useState([]);
  const [cinemaId, setCinemaId] = useState("");
  const [selectedDate, setSelectedDate] = useState(formatDate(new Date()));
  const [showtimes, setShowtimes] = useState([]);
  const [selectedShowtime, setSelectedShowtime] = useState(null);

  const [room, setRoom] = useState(null);
  const [seats, setSeats] = useState([]);
  const [bookedSeatIds, setBookedSeatIds] = useState([]);
  const [selectedSeats, setSelectedSeats] = useState([]);

  const [paymentMethod, setPaymentMethod] = useState("momo");
  const [booking, setBooking] = useState(null);
  const [tickets, setTickets] = useState([]);

  const [loading, setLoading] = useState(true);
  const [loadingShowtimes, setLoadingShowtimes] = useState(false);
  const [loadingSeats, setLoadingSeats] = useState(false);
  const [processing, setProcessing] = useState(false);
  const [error, setError] = useState("");

  const token = localStorage.getItem("cineglobeToken");

  const selectedTotal = useMemo(
    () => selectedSeats.reduce(
      (sum, seat) => sum + Number(seat.price || 0), 0
    ),
    [selectedSeats]
  );

  const dates = useMemo(() => {
    return Array.from({ length: 7 }, (_, index) => {
      const date = new Date();
      date.setDate(date.getDate() + index);

      return {
        value: formatDate(date),
        day: index === 0
          ? "Hôm nay"
          : date.toLocaleDateString("vi-VN", { weekday: "short" }),
        number: date.getDate(),
        month: date.getMonth() + 1
      };
    });
  }, []);

  // TẢI PHIM VÀ DANH SÁCH RẠP
  useEffect(() => {
    if (!token) {
      alert("Vui lòng đăng nhập để đặt vé.");
      navigate("/login");
      return;
    }

    if (!movieId) {
      setError("Không lấy được mã phim từ đường dẫn. Vui lòng quay lại trang chủ và chọn phim.");
      setLoading(false);
      return;
    }

    const loadInitialData = async () => {
      try {
        setLoading(true);
        setError("");

        const [movieResponse, cinemaResponse] = await Promise.all([
          fetch(`${API}/movies`),
          fetch(`${API}/cinemas`)
        ]);

        if (!movieResponse.ok) {
          throw new Error("Không thể tải danh sách phim.");
        }

        if (!cinemaResponse.ok) {
          throw new Error("Không thể tải danh sách rạp.");
        }

        const movieResult = await movieResponse.json();
        const cinemaResult = await cinemaResponse.json();

        const movieList = Array.isArray(movieResult)
          ? movieResult
          : movieResult.movies || movieResult.data || movieResult.results || [];

        const cinemaList = Array.isArray(cinemaResult)
          ? cinemaResult
          : cinemaResult.cinemas || cinemaResult.data || cinemaResult.results || [];

        const normalizedMovieId = String(movieId).trim();

        const foundMovie = movieList.find(
          (item) => getId(item).trim() === normalizedMovieId
        );

        console.log("Movie ID trên URL:", normalizedMovieId);
        console.log(
          "Danh sách ID phim từ API:",
          movieList.map((item) => getId(item))
        );

        if (!foundMovie) {
          throw new Error(
            "Không tìm thấy phim này trong hệ thống. Vui lòng quay lại trang chủ và chọn phim lại."
          );
        }

        setMovie(foundMovie);
        setCinemas(cinemaList);

        if (cinemaList.length > 0) {
          setCinemaId(getId(cinemaList[0]));
        } else {
          setError("Hiện chưa có rạp chiếu phim nào trong hệ thống.");
        }
      } catch (err) {
        console.error("Lỗi tải dữ liệu đặt vé:", err);
        setError(err.message || "Có lỗi khi tải dữ liệu.");
      } finally {
        setLoading(false);
      }
    };

    loadInitialData();
  }, [movieId, navigate, token]);

  // TẢI SUẤT CHIẾU
  useEffect(() => {
    if (!movieId || !cinemaId || booking) return;

    const loadShowtimes = async () => {
      try {
        setLoadingShowtimes(true);
        setError("");
        setSelectedShowtime(null);
        setSeats([]);
        setSelectedSeats([]);
        setRoom(null);

        const params = new URLSearchParams({
          movieId,
          cinemaId,
          date: selectedDate
        });

        const response = await fetch(`${API}/showtimes?${params}`);

        if (!response.ok) {
          throw new Error("Không thể tải suất chiếu.");
        }

        const result = await response.json();

        const list = Array.isArray(result)
          ? result
          : result.showtimes || result.data || [];

        setShowtimes(list);
      } catch (err) {
        console.error("Lỗi tải suất chiếu:", err);
        setShowtimes([]);
        setError(err.message || "Không thể tải suất chiếu.");
      } finally {
        setLoadingShowtimes(false);
      }
    };

    loadShowtimes();
  }, [movieId, cinemaId, selectedDate, booking]);

  // CHỌN SUẤT CHIẾU VÀ TẢI SƠ ĐỒ GHẾ
  const chooseShowtime = async (showtime) => {
    try {
      setSelectedShowtime(showtime);
      setSelectedSeats([]);
      setSeats([]);
      setRoom(null);
      setBookedSeatIds([]);
      setError("");
      setLoadingSeats(true);

      const roomId = getId(showtime.room);
      const showtimeId = getId(showtime);

      if (!roomId) {
        throw new Error("Suất chiếu chưa được gán phòng.");
      }

      const response = await fetch(
        `${API}/seats/room/${roomId}?showtimeId=${showtimeId}`
      );

      const result = await response.json();

      if (!response.ok) {
        throw new Error(result.message || "Không thể tải sơ đồ ghế.");
      }

      setRoom(result.room);
      setSeats(result.seats || []);
      setBookedSeatIds((result.bookedSeatIds || []).map(getId));
    } catch (err) {
      console.error("Lỗi tải ghế:", err);
      setError(err.message || "Không thể tải sơ đồ ghế.");
    } finally {
      setLoadingSeats(false);
    }
  };

  // CHỌN HOẶC BỎ CHỌN GHẾ
  const toggleSeat = (seat) => {
    const seatId = getId(seat);

    if (bookedSeatIds.includes(seatId)) return;

    setSelectedSeats((current) => {
      const exists = current.some((item) => getId(item) === seatId);

      if (exists) {
        return current.filter((item) => getId(item) !== seatId);
      }

      if (current.length >= 8) {
        setError("Mỗi lần chỉ được chọn tối đa 8 ghế.");
        return current;
      }

      setError("");
      return [...current, seat];
    });
  };

  // TẠO ĐƠN ĐẶT VÉ
  const createBooking = async () => {
    if (!selectedShowtime || selectedSeats.length === 0) {
      setError("Vui lòng chọn suất chiếu và ít nhất một ghế.");
      return;
    }

    try {
      setProcessing(true);
      setError("");

      const response = await fetch(`${API}/bookings`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Authorization: `Bearer ${token}`
        },
        body: JSON.stringify({
          showtimeId: getId(selectedShowtime),
          seatIds: selectedSeats.map(getId)
        })
      });

      const result = await response.json();

      if (!response.ok) {
        throw new Error(result.message || "Không thể tạo đơn đặt vé.");
      }

      const newBooking = result.booking || result.data;

      if (!newBooking?._id) {
        throw new Error("Máy chủ không trả về thông tin đơn đặt vé.");
      }

      // Cập nhật trạng thái ghế ngay khi đơn được tạo.
// Ghế đang được giữ sẽ không còn hiển thị là ghế trống.
setBookedSeatIds((current) => [
  ...new Set([
    ...current,
    ...selectedSeats.map((seat) => getId(seat))
  ])
]);

setBooking(newBooking);
    } catch (err) {
      console.error("Lỗi tạo đơn đặt vé:", err);
      setError(err.message || "Không thể tạo đơn đặt vé.");

      if (selectedShowtime) {
        chooseShowtime(selectedShowtime);
      }
    } finally {
      setProcessing(false);
    }
  };

  // THANH TOÁN
  const payBooking = async () => {
    if (!booking?._id) return;

    try {
      setProcessing(true);
      setError("");

      const response = await fetch(`${API}/payments`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Authorization: `Bearer ${token}`
        },
        body: JSON.stringify({
          bookingId: booking._id,
          paymentMethod
        })
      });

      const result = await response.json();

      if (!response.ok) {
        throw new Error(
          result.message || "Không thể tạo giao dịch thanh toán."
        );
      }

      const newPayment = result.payment || result.data;

      if (!newPayment?._id) {
        throw new Error("Không nhận được thông tin giao dịch.");
      }

      const confirmResponse = await fetch(
        `${API}/payments/${newPayment._id}/demo-confirm`,
        {
          method: "POST",
          headers: {
            Authorization: `Bearer ${token}`
          }
        }
      );

      const confirmResult = await confirmResponse.json();

      if (!confirmResponse.ok) {
        throw new Error(
          confirmResult.message || "Xác nhận thanh toán thất bại."
        );
      }

      setTickets(confirmResult.tickets || []);

      setBooking((current) => ({
        ...current,
        status: "confirmed",
        paymentStatus: "paid"
      }));
    } catch (err) {
      console.error("Lỗi thanh toán:", err);
      setError(err.message || "Thanh toán thất bại.");
    } finally {
      setProcessing(false);
    }
  };

  
const getSeatClass = (seat) => {
  const seatId = getId(seat);

  // Ghế đã được đặt
  if (bookedSeatIds.includes(seatId)) {
    return "seat-booked";
  }

  // Ghế người dùng đang chọn
  if (selectedSeats.some((item) => getId(item) === seatId)) {
    return "seat-selected";
  }

  // Nhận diện loại ghế, không phân biệt chữ hoa/thường
  const type = String(seat.seatType || "standard")
    .toLowerCase()
    .trim();

  if (["vip", "premium"].includes(type)) {
    return "seat-vip";
  }

  if (["couple", "sweetbox", "sweet-box", "sweet_box"].includes(type)) {
    return "seat-couple";
  }

  return "seat-standard";
};


  // TRẠNG THÁI ĐANG TẢI
  if (loading) {
    return (
      <div className="booking-loading">
        <LoaderCircle className="spin" size={36} />
        <p>Đang chuẩn bị trải nghiệm đặt vé...</p>
      </div>
    );
  }

  // KHÔNG TÌM THẤY PHIM
  if (!movie) {
    return (
      <div className="booking-page">
        <div className="booking-error-page">
          <AlertCircle size={40} />
          <h2>Không thể mở trang đặt vé</h2>
          <p>{error || "Không tìm thấy phim."}</p>
          <Link to="/" className="booking-back-button">
            <ArrowLeft size={17} /> Về trang chủ
          </Link>
        </div>
      </div>
    );
  }

  const moviePoster =
    movie.poster ||
    movie.posterUrl ||
    "https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?w=600";

  return (
    <div className="booking-page">
      <header className="booking-header">
        <Link to="/" className="booking-brand">
          <span className="booking-brand-icon">C</span>
          Cine<span>Globe</span>
        </Link>

        <Link to="/" className="booking-back-button">
          <ArrowLeft size={17} /> Quay lại
        </Link>
      </header>

      <main className="booking-container">
        <div className="booking-heading">
          <div>
            <p className="booking-eyebrow">CINEGLOBE BOOKING</p>
            <h1>Đặt vé xem phim</h1>
            <p>Chọn rạp, suất chiếu và vị trí ghế yêu thích của bạn.</p>
          </div>

          <div className="booking-step-indicator">
            <span className={booking ? "done" : "active"}>01</span>
            <i />
            <span className={booking ? "active" : ""}>02</span>
            <i />
            <span className={tickets.length ? "done" : ""}>03</span>
          </div>
        </div>

        <section className="booking-movie-card">
          <img src={moviePoster} alt={movie.title} />

          <div className="booking-movie-info">
            <span className="booking-movie-label">
              <Film size={14} /> ĐANG CHỌN PHIM
            </span>
            <h2>{movie.title}</h2>
            <p>
              {movie.duration || 120} phút
              {" • "}
              {movie.ageRating || "Tất cả độ tuổi"}
            </p>
            <div className="booking-genres">
              {(movie.genres || []).slice(0, 3).map((genre) => (
                <span key={genre}>{genre}</span>
              ))}
            </div>
          </div>
        </section>

        {error && (
          <div className="booking-alert">
            <AlertCircle size={18} />
            {error}
            <button onClick={() => setError("")}>Đóng</button>
          </div>
        )}

        {!booking && (
          <>
            <section className="booking-section">
              <div className="booking-section-title">
                <span>01</span>
                <div>
                  <h2>Chọn rạp chiếu</h2>
                  <p>Lựa chọn địa điểm thuận tiện cho bạn.</p>
                </div>
              </div>

              <div className="cinema-options">
                {cinemas.map((cinema) => (
                  <button
                    key={getId(cinema)}
                    className={
                      cinemaId === getId(cinema)
                        ? "cinema-option active"
                        : "cinema-option"
                    }
                    onClick={() => {
                      setCinemaId(getId(cinema));
                      setSelectedShowtime(null);
                      setSelectedSeats([]);
                    }}
                  >
                    <span className="cinema-option-icon">
                      <MapPin size={20} />
                    </span>
                    <span>
                      <strong>{cinema.name}</strong>
                      <small>{cinema.address || cinema.city}</small>
                    </span>
                    {cinemaId === getId(cinema) && (
                      <CheckCircle2 size={20} />
                    )}
                  </button>
                ))}
              </div>
            </section>

            <section className="booking-section">
              <div className="booking-section-title">
                <span>02</span>
                <div>
                  <h2>Chọn ngày xem</h2>
                  <p>Suất chiếu trong 7 ngày tiếp theo.</p>
                </div>
              </div>

              <div className="date-options">
                {dates.map((date) => (
                  <button
                    key={date.value}
                    className={
                      selectedDate === date.value
                        ? "date-option active"
                        : "date-option"
                    }
                    onClick={() => {
                      setSelectedDate(date.value);
                      setSelectedShowtime(null);
                      setSelectedSeats([]);
                    }}
                  >
                    <small>{date.day}</small>
                    <strong>{date.number}</strong>
                    <small>Tháng {date.month}</small>
                  </button>
                ))}
              </div>
            </section>

            <section className="booking-section">
              <div className="booking-section-title">
                <span>03</span>
                <div>
                  <h2>Chọn suất chiếu</h2>
                  <p>Giờ chiếu được cập nhật từ hệ thống.</p>
                </div>
              </div>

              {loadingShowtimes ? (
                <div className="booking-empty">
                  <LoaderCircle className="spin" />
                  Đang tải suất chiếu...
                </div>
              ) : showtimes.length === 0 ? (
                <div className="booking-empty">
                  <CalendarDays size={30} />
                  <strong>Chưa có suất chiếu</strong>
                  <p>Hãy thử chọn ngày khác hoặc rạp khác.</p>
                </div>
              ) : (
                <div className="showtime-options">
                  {showtimes.map((showtime) => (
                    <button
                      key={getId(showtime)}
                      className={
                        getId(selectedShowtime) === getId(showtime)
                          ? "showtime-option active"
                          : "showtime-option"
                      }
                      onClick={() => chooseShowtime(showtime)}
                    >
                      <Clock size={16} />
                      <strong>{formatTime(showtime.startTime)}</strong>
                      <small>{showtime.room?.name || "Phòng chiếu"}</small>
                    </button>
                  ))}
                </div>
              )}
            </section>

            {selectedShowtime && (
              <section className="booking-section seat-section">
                <div className="booking-section-title">
                  <span>04</span>
                  <div>
                    <h2>Chọn ghế ngồi</h2>
                    <p>
                      {room?.name || selectedShowtime.room?.name || "Phòng chiếu"}
                      {" • "}Tối đa 8 ghế mỗi lượt.
                    </p>
                  </div>
                </div>

                {loadingSeats ? (
                  <div className="booking-empty">
                    <LoaderCircle className="spin" />
                    Đang tải sơ đồ ghế...
                  </div>
                ) : (
                  <>
                   <div className="seat-legend">
  <span><i className="legend-standard" /> Ghế thường</span>
  <span><i className="legend-vip" /> Ghế VIP</span>
  <span><i className="legend-couple" /> Ghế đôi Sweetbox</span>
  <span><i className="legend-selected" /> Đang chọn</span>
  <span><i className="legend-booked" /> Đã đặt / đang giữ</span>
</div>

                    <div className="screen-area">
                      <div className="screen-shape"></div>
                      <span>MÀN HÌNH</span>
                    </div>

                    <div className="seat-map">
                      {["A", "B", "C", "D", "E","F"].map((rowName) => {
                        const rowSeats = seats.filter(
                          (seat) => seat.row === rowName
                        );

                        if (!rowSeats.length) return null;

                        return (
                          <div className="seat-row" key={rowName}>
                            <span className="seat-row-label">{rowName}</span>

                            {rowSeats.map((seat) => {
                              const isBooked = bookedSeatIds.includes(getId(seat));
                              const isSelected = selectedSeats.some(
                                (item) => getId(item) === getId(seat)
                              );

                              return (
                                <button
                                  key={getId(seat)}
                                  title={`${seat.seatNumber || seat.number} - ${formatMoney(seat.price)}`}
                                  disabled={isBooked}
                                  className={`seat ${getSeatClass(seat)}`}
                                  onClick={() => toggleSeat(seat)}
                                >
                                  <Armchair size={17} />
                                  <small>{seat.number || seat.seatNumber}</small>
                                  {isSelected && (
                                    <CheckCircle2 className="seat-check" size={12} />
                                  )}
                                </button>
                              );
                            })}

                            <span className="seat-row-label">{rowName}</span>
                          </div>
                        );
                      })}
                    </div>

                   <div className="seat-price-note">
  <span>Ghế thường: 75.000đ</span>
  <span>Ghế VIP: 100.000đ</span>
  <span>Ghế đôi: Theo giá trong hệ thống</span>
</div>

                    <div className="booking-summary">
                      <div>
                        <small>Ghế đã chọn</small>
                        <strong>
                          {selectedSeats.length
                            ? selectedSeats.map((seat) => seat.seatNumber || seat.number).join(", ")
                            : "Chưa chọn ghế"}
                        </strong>
                      </div>
                      <div>
                        <small>Tổng tiền</small>
                        <strong className="booking-total">
                          {formatMoney(selectedTotal)}
                        </strong>
                      </div>
                    </div>

                    <button
                      className="booking-primary-button"
                      disabled={!selectedSeats.length || processing}
                      onClick={createBooking}
                    >
                      {processing ? (
                        <LoaderCircle className="spin" size={18} />
                      ) : (
                        <Ticket size={18} />
                      )}
                      Xác nhận chọn ghế
                    </button>
                  </>
                )}
              </section>
            )}
          </>
        )}

        {booking && tickets.length === 0 && (
          <section className="booking-section payment-section">
            <div className="booking-section-title">
              <span>05</span>
              <div>
                <h2>Thanh toán vé</h2>
                <p>Đơn đặt vé đã được tạo. Chọn phương thức thanh toán.</p>
              </div>
            </div>

            <div className="payment-booking-info">
              <div>
                <small>Mã đặt vé</small>
                <strong>{booking.bookingCode}</strong>
              </div>
              <div>
                <small>Số lượng ghế</small>
                <strong>{booking.totalSeats} ghế</strong>
              </div>
              <div>
                <small>Tổng thanh toán</small>
                <strong>{formatMoney(booking.finalAmount)}</strong>
              </div>
              <div>
                <small>Thời hạn giữ ghế</small>
                <strong>10 phút</strong>
              </div>
            </div>

            <div className="payment-options">
              {[
                { value: "momo", title: "Ví MoMo", description: "Thanh toán mô phỏng qua MoMo", icon: "M" },
                { value: "vnpay", title: "VNPay", description: "Thanh toán mô phỏng qua VNPay", icon: "V" },
                { value: "zalopay", title: "ZaloPay", description: "Thanh toán mô phỏng qua ZaloPay", icon: "Z" },
                { value: "banking", title: "Chuyển khoản", description: "Thanh toán mô phỏng qua ngân hàng", icon: "B" },
                { value: "cash", title: "Tiền mặt", description: "Phương thức thanh toán demo", icon: "₫" }
              ].map((method) => (
                <button
                  key={method.value}
                  className={
                    paymentMethod === method.value
                      ? "payment-option active"
                      : "payment-option"
                  }
                  onClick={() => setPaymentMethod(method.value)}
                >
                  <span className="payment-icon">{method.icon}</span>
                  <span>
                    <strong>{method.title}</strong>
                    <small>{method.description}</small>
                  </span>
                  <span className="payment-radio">
                    {paymentMethod === method.value && <CheckCircle2 size={18} />}
                  </span>
                </button>
              ))}
            </div>

            <div className="demo-payment-note">
              <AlertCircle size={17} />
              Đây là thanh toán mô phỏng phục vụ đồ án, chưa kết nối cổng thanh toán thật.
            </div>

            <button
              className="booking-primary-button"
              disabled={processing}
              onClick={payBooking}
            >
              {processing ? (
                <LoaderCircle className="spin" size={18} />
              ) : (
                <CreditCard size={18} />
              )}
              Thanh toán {formatMoney(booking.finalAmount)}
            </button>
          </section>
        )}

        {tickets.length > 0 && (
          <section className="ticket-success-section">
            <div className="ticket-success-icon">
              <CheckCircle2 size={42} />
            </div>
            <p className="booking-eyebrow">PAYMENT SUCCESSFUL</p>
            <h2>Đặt vé thành công!</h2>
            <p>Vé điện tử đã được tạo. Hãy xuất trình mã QR khi đến rạp.</p>

            <div className="digital-tickets">
              {tickets.map((ticket) => (
                <article className="digital-ticket" key={ticket._id}>
                  <div className="digital-ticket-top">
                    <div>
                      <span>CINEGLOBE E-TICKET</span>
                      <h3>{movie.title}</h3>
                    </div>
                    <Ticket size={25} />
                  </div>

                  <div className="digital-ticket-details">
                    <div>
                      <small>MÃ VÉ</small>
                      <strong>{ticket.ticketCode}</strong>
                    </div>
                    <div>
                      <small>GHẾ</small>
                      <strong>{ticket.seatNumber}</strong>
                    </div>
                    <div>
                      <small>PHÒNG</small>
                      <strong>{room?.name || selectedShowtime?.room?.name || "—"}</strong>
                    </div>
                  </div>

                  {ticket.qrCode && (
                    <img
                      className="ticket-qr"
                      src={ticket.qrCode}
                      alt={`QR vé ${ticket.ticketCode}`}
                    />
                  )}

                  <p className="ticket-qr-caption">
                    Quét mã QR tại quầy soát vé
                  </p>
                </article>
              ))}
            </div>

            <button
              className="booking-primary-button"
              onClick={() => navigate("/my-tickets")}
            >
              <Ticket size={18} /> Xem vé của tôi
            </button>

            <Link to="/" className="booking-home-link">
              <ArrowLeft size={17} /> Quay về trang chủ
            </Link>
          </section>
        )}
      </main>
    </div>
  );
}

export default BookingPage;
